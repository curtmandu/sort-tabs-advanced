{
  "manifest_version": 3,
  "name": "Sort Selected Tabs",
  "version": "1.0.0",
  "author": "Quillfinch (fork of Sort tabs advanced by Mois Moshev)",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "description": "Sort only the tabs you have selected, or all tabs, by URL, domain, title, last access or container. Fork of Sort tabs advanced.",
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Sort Selected Tabs",
    "default_popup": "popup/picker.html"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextualIdentities"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sort-selected-tabs@quillfinch",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
